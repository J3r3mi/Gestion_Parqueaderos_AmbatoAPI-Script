        "type": "object",
        "properties": {
          "token": {
            "minLength": 1,
            "type": "string"
          },
          "nuevaPassword": {
            "minLength": 6,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RolUsuario": {
        "enum": [
          0,
          1,
          2
        ],
        "type": "integer",
        "format": "int32"
      },
      "SolicitarRecuperacionRequestDto": {
        "required": [
          "identificador"
        ],
        "type": "object",
        "properties": {
          "identificador": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "TipoVehiculo": {
        "enum": [
          0,
          1,
          2
        ],
        "type": "integer",
        "format": "int32"
      },
      "ValidarAccesoRequestDto": {
        "type": "object",
        "properties": {
          "qrToken": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Ingresa: Bearer {tu token}",
        "scheme": "Bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
