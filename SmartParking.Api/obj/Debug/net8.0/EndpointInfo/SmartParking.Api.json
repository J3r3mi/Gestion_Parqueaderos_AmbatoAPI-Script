            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "ActualizarParqueaderoRequestDto": {
        "required": [
          "direccion",
          "nombre"
        ],
        "type": "object",
        "properties": {
          "nombre": {
            "minLength": 1,
            "type": "string"
          },
          "direccion": {
            "minLength": 1,
            "type": "string"
          },
          "latitud": {
            "type": "number",
            "format": "double"
          },
          "longitud": {
            "type": "number",
            "format": "double"
          },
          "activo": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "CrearParqueaderoRequestDto": {
        "required": [
          "direccion",
          "nombre"
        ],
        "type": "object",
        "properties": {
          "nombre": {
            "minLength": 1,
            "type": "string"
          },
          "direccion": {
            "minLength": 1,
            "type": "string"
          },
          "latitud": {
            "maximum": 2,
            "minimum": -5,
            "type": "number",
            "format": "double"
          },
          "longitud": {
            "maximum": -75,
            "minimum": -92,
            "type": "number",
            "format": "double"
          },
          "capacidadTotal": {
            "maximum": 1000,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CrearPlazaRequestDto": {
        "required": [
          "codigo",
          "tipoVehiculo"
        ],
        "type": "object",
        "properties": {
          "codigo": {
            "maxLength": 10,
            "minLength": 1,
            "type": "string"
          },
          "tipoVehiculo": {
            "$ref": "#/components/schemas/TipoVehiculo"
          }
        },
        "additionalProperties": false
      },
      "CrearReservaRequestDto": {
        "required": [
          "horaEstimadaArribo",
          "plazaId"
        ],
        "type": "object",
        "properties": {
          "plazaId": {
            "type": "integer",
            "format": "int32"
          },
          "horaEstimadaArribo": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "CrearTarifaRequestDto": {
        "required": [
          "tipoVehiculo"
        ],
        "type": "object",
        "properties": {
          "tipoVehiculo": {
            "$ref": "#/components/schemas/TipoVehiculo"
          },
          "valorHora": {
            "maximum": 100,
            "minimum": 0,01,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "EstadoPlaza": {
        "enum": [
          0,
          1,
          2,
          3
        ],
        "type": "integer",
        "format": "int32"
      },
      "LoginRequestDto": {
        "required": [
          "identificador",
          "password"
        ],
        "type": "object",
        "properties": {
          "identificador": {
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RegisterRequestDto": {
        "required": [
          "cedula",
          "correo",
          "nombre",
          "password"
        ],
        "type": "object",
        "properties": {
          "nombre": {
            "minLength": 1,
            "type": "string"
          },
          "cedula": {
            "minLength": 1,
            "type": "string"
          },
          "correo": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 6,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RegistrarStaffRequestDto": {
        "required": [
          "cedula",
          "correo",
          "nombre",
          "password",
          "rol"
        ],
        "type": "object",
        "properties": {
          "nombre": {
            "minLength": 1,
            "type": "string"
          },
          "cedula": {
            "minLength": 1,
            "type": "string"
          },
          "correo": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 6,
            "type": "string"
          },
          "rol": {
            "$ref": "#/components/schemas/RolUsuario"
          }
        },
        "additionalProperties": false
      },
      "RestablecerPasswordRequestDto": {
        "required": [
